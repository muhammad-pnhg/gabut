# Nilai ini dipakai Worker, bukan dibaca saat build.
# Isi lewat `npx wrangler secret put NAMA` (jangan commit nilai aslinya).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Verifikasi Turnstile. Secret disimpan lewat `npx wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=

# Nilai PUBLIC_* dibaca saat build. Set di mesin build atau dashboard CI,
# lalu build ulang. Mengubahnya tidak cukup dengan deploy ulang saja.
PUBLIC_SITE_URL=https://toolsman.anakkampus.workers.dev
PUBLIC_TURNSTILE_SITE_KEY=

# Opsional. Kalau diisi, model penghapus latar dipakai dari folder sendiri,
# bukan dari CDN staticimgly.com. Jalankan `npm run models:fetch` dulu.
# PUBLIC_IMGLY_PATH=/models/imgly/

# Opsional. Kalau diisi, analitik Plausible dimuat. Tanpa cookie.
# PUBLIC_PLAUSIBLE_DOMAIN=toolsman.anakkampus.workers.dev
