---
import type { ToolMeta } from '../lib/tool-types';
import { categoryLabel, privacyLabel, statusLabel } from '../lib/tool-types';
import Icon from './ui/Icon.astro';

interface Props {
	tool: ToolMeta;
}

const { tool } = Astro.props;
---

<a class="tool-card" href={`/tools/${tool.slug}/`} data-category={tool.category}>
	<span class="tool-card__top">
		<span class="tool-tile"><Icon name={tool.icon} size={22} /></span>
		<span class="category-label">{categoryLabel(tool.category)}</span>
	</span>
	<span class="tool-card__name">{tool.name}</span>
	<span class="tool-card__desc">{tool.tagline}</span>
	<span class="tool-card__foot">
		<span class="privacy-label">
			<Icon name={tool.privacy === 'lokal' ? 'laptop' : 'server'} size={16} />
			{privacyLabel[tool.privacy]}
		</span>
		<span class="status-label">{statusLabel[tool.status]}</span>
	</span>
</a>
