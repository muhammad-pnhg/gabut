---
import Catalog from '../components/Catalog.astro';
import Input from '../components/ui/Input.astro';
import Layout from '../layouts/Layout.astro';
import { tools } from '../lib/tools';
import { SITE_DESCRIPTION, absoluteUrl } from '../lib/site';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Toolsman',
	url: absoluteUrl('/'),
	description: SITE_DESCRIPTION,
	inLanguage: 'id-ID',
};
---

<Layout
	title="Toolsman, kotak perkakas untuk kuliah dan koding"
	description={SITE_DESCRIPTION}
	jsonLd={jsonLd}
>
	<section class="hero container" aria-labelledby="hero-title">
		<h1 class="hero__title" id="hero-title">Semua perkakas kuliahmu, satu kotak.</h1>
		<p class="hero__lede">
			Alat gambar, diagram, PDF, pas foto, kirim file, dan generator teks. Gratis
			dan tanpa akun.
		</p>

		<p class="status-note">
			<span>
				<strong>Enam alat sudah bisa dipakai.</strong> Gambar, diagram, PDF, pas foto,
				kirim file, dan generator teks. Gratis, tanpa akun.
			</span>
		</p>

		<div class="hero__search">
			<Input
				id="catalog-search"
				label="Cari alat"
				type="search"
				placeholder="mis. gabung pdf atau flowchart"
				hint="Tekan / atau Ctrl+K untuk membuka pencarian dari halaman mana saja."
			/>
		</div>
	</section>

	<Catalog tools={tools} />

	<section class="principles" aria-labelledby="principles-title">
		<div class="container">
			<h2 class="section-title" id="principles-title">Aturan yang kami pakai</h2>
			<p class="hero__lede">Ini yang menentukan bentuk Toolsman.</p>

			<div class="principles__grid">
				<div>
					<h3 class="principle__title">Gratis dan tanpa akun</h3>
					<p class="principle__body">
						Semua alat P0 bisa dipakai tanpa daftar. Tidak ada batas harian yang
						ujungnya menyuruh kamu bikin akun.
					</p>
				</div>
				<div>
					<h3 class="principle__title">File tetap di perangkatmu</h3>
					<p class="principle__body">
						Draw, diagram, PDF, pas foto, dan generator memproses file di browser.
						Kirim File memakai server karena link harus bisa dibuka orang lain,
						dan itu ditandai di kartunya.
					</p>
				</div>
				<div>
					<h3 class="principle__title">Satu pola untuk semua alat</h3>
					<p class="principle__body">
						Tiap halaman alat punya susunan yang sama: area kerja, panel opsi, satu
						tombol utama. Kamu tidak perlu belajar ulang tiap alat.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
